# Copie para .env e preencha. NUNCA versione o .env.
# Gere segredos com:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------- Painel (obrigatório — o app NÃO sobe sem isso) ----------
ADMIN_USER=Admin
# mínimo 10 caracteres
ADMIN_PASSWORD=
# mínimo 32 caracteres aleatórios; trocar invalida todos os logins
APP_SECRET=
# validade do login em horas
TOKEN_TTL_HOURS=12
# tentativas de login por IP dentro da janela (segundos)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# origens que podem chamar a API de outro domínio (separadas por vírgula).
# Vazio = só o mesmo domínio (o painel servido pelo próprio Flask). Ex.: https://painel.seudominio.com
CORS_ORIGINS=

# ---------- Servidor ----------
PORT=5050
TZ=America/Sao_Paulo
# arquivo SQLite com conversas, bloqueios (opt-out) e contadores diários
DB_PATH=data/verona.db
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# json (produção) ou plain
LOG_FORMAT=json

# ---------- OpenAI (IA da conversa) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Telegram (avisos para o corretor) ----------
TELEGRAM_BOT_TOKEN=
# IDs de chat autorizados (vírgula). Vazio = só o chat que já usava o bot / o 1º a falar com ele.
TELEGRAM_ALLOWED_CHAT_IDS=
# chat que recebe os alertas (padrão: o menor ID autorizado)
TELEGRAM_BROKER_CHAT_ID=
# 1 = desliga verificação TLS (NÃO recomendado; só atrás de proxy que reescreve certificado)
TELEGRAM_INSECURE_TLS=

# ---------- Evolution API (WhatsApp, NÃO oficial) ----------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# obrigatório: sem ele o webhook responde 503. Configure a mesma string na Evolution
# (header "Authorization: Bearer <token>" ou ?token=<token> na URL do webhook)
EVOLUTION_WEBHOOK_TOKEN=

# ---------- Opt-out / LGPD ----------
# frase anexada à primeira mensagem (desligue pelo painel: opt_out_footer=false)
OPT_OUT_FOOTER=Se não quiser receber mensagens, responda SAIR.
# resposta enviada uma única vez quando o lead pede para sair
OPT_OUT_CONFIRMATION=Tudo bem, você não receberá mais mensagens nossas. Desculpe o incômodo!
# palavras extras de saída, separadas por vírgula (além de SAIR, PARAR, NÃO QUERO...)
OPT_OUT_KEYWORDS=

# ---------- Google (Sheets / Calendar) ----------
# JSON da service account (texto puro ou base64). Alternativa: arquivo credentials.json
GOOGLE_CREDENTIALS=
CALENDAR_ID=
BROKER_EMAIL_FOR_CALENDAR=
# tentativas com backoff em erros 429/5xx da API do Sheets
SHEETS_RETRIES=4
# cache de cabeçalho (s) e da lista de abas (s); 0 desliga o cache de cabeçalho
SHEETS_HEADER_TTL=60
SHEETS_LIST_TTL=300
# 1 = confia em X-Forwarded-For de qualquer origem (padrão: só de 127.x/rede privada = proxy)
TRUST_PROXY_HEADERS=

# ---------- Raspagem OAB (Playwright) ----------
OAB_TIMEOUT_MS=30000
OAB_OPEN_RETRIES=3
# aborta o job e avisa no Telegram após N falhas seguidas
OAB_MAX_CONSECUTIVE_FAILURES=5
